---
import type { GetStaticPaths } from "astro";
import MainLayout from "../../Layout/MainLayout.astro";
import PokemonsCard from "../../components/pokemons/pokemonsCard.astro";
import type { PokemonResponse } from "../../interface/pokemon-list.response";
import Title from "@components/shared/title.astro";
import { Icon } from 'astro-icon/components'

export const getStaticPaths = (async () => {
  const resp = await fetch("https://pokeapi.co/api/v2/pokemon?limit=151");
  const { results } = (await resp.json()) as PokemonResponse;

  return results.map((poke) => ({
    params: { name: poke.name },
    props: { name: poke.name, url: poke.url },
  }));
}) satisfies GetStaticPaths;

const { name } = Astro.params;
const { url } = Astro.props;
const id = url.split("/").at(-2);
const audioSource = `https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/${id}.ogg`;
const imagenSrc = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`;
---

<MainLayout
  title={`Pokemon - #${id} ${name}`}
  description={`Informacion sobre el pokemon ${name}`}
  image=`${imagenSrc}`
>
  <section class="mt-10 mx-10 flex flex-col justify-center items-center">
    <div class="flex flex-row">
      <div>
        <button onclick="history.back()" class="text-blue-500 cursor-pointer"
        >Regresar</button>
        <Title>{name}</Title>
      </div>
      <button id="btn-favorite" class="ml-4 hover:animate-pulse" data-name={name}
      data-id={id} >
        <Icon name='heart-outline' size={50}/>
        <Icon class='hidden' name='heart-full' size={50}/>
      </button>
    </div>

    </section>
    <PokemonsCard name={name} url={url} isBig={true} />
    <audio controls class="mt-5">
      <source src={audioSource} />
      Your browseer does no support the audio element.
    </audio>
</MainLayout>

<script>
interface FavoritePokemon{
  name: string,
  id: number,
}

const btnFavorite = document.querySelector('#btn-favorite')as HTMLButtonElement;
const name = btnFavorite.dataset.name;
const id = btnFavorite.dataset.id;

btnFavorite.addEventListener('click',()=>{
  console.log(name, id);
  
})

</script>