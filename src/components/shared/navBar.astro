---
const links = [
  { href: "/", text: "Listado" },
  { href: "/pokemons/1", text: "Paginado" },
  { href: "/Favorites", text: "Favoritos" },
];

const currentPath = Astro.url.pathname;
console.log(currentPath);
---

<!-- component -->
<nav class="bg-white shadow dark:bg-gray-800">
  <div
    class="container flex items-center justify-center p-6 mx-auto text-gray-600 capitalize dark:text-gray-300"
  >
    <!-- {
            links.map(({href, text}) => (
                <a
                    href={href}
                    class:list={['text-gray-800 dark:text-gray-200 mx-1.5 sm:mx-6',
                        {
                            'border-blue-500 border-b-2': currentPath===href,
                        }
                    ]}
                >
                    {text}
                </a>
            ))
        } -->

    {
      links.map(({ href, text }) => (
        <div>
          <a
            href={href}
            class="text-gray-800 dark:text-gray-200 mx-1.5 sm:mx-6"
            >
            {text}
          </a>
          {currentPath === href &&(
            <div 
            transition:name="menu-line"
            class="border-blue-500 border-b-2 mx-4"/>
          )

          }
        </div>
        ))
      }
  </div>
</nav>
